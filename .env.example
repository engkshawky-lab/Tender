# Copy to .env (next to docker-compose.yml) and fill in. Never commit .env.
# Claude API key from the Anthropic Console (console.anthropic.com) → API Keys (starts with sk-ant-)
ANTHROPIC_API_KEY=
DB_PASSWORD=change-me
ADMIN_PASSWORD=change-me-now
# Long random string for signing logins (optional — generated automatically if empty)
SECRET_KEY=
